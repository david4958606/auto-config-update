            <setOnoffSp type="method">/IO/Ch4/DryPump/OnoffDO</setOnoffSp>
        </PhyDryPump>
    </Vacuum>
    <ProcessLogger class="ProcessLogger" type="instance" alias="">
        <!-- Not in a PVD class, should skip-->
